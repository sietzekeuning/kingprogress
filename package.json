{
    "name": "progressy",
    "version": "1.2.0",
    "description": "GitHub Actions progress monitor",
    "main": "dist/main.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
        "dev:main": "tsc -w -p tsconfig.main.json",
        "dev:renderer": "vite",
        "build": "npm run build:main && npm run build:renderer",
        "build:main": "tsc -p tsconfig.main.json",
        "build:renderer": "vite build",
        "start": "electron .",
        "package": "npm run build && electron-builder",
        "package:mac": "npm run build && electron-builder --mac",
        "notarize:dmg": "bash scripts/notarize-dmg.sh",
        "release": "bash scripts/publish-release.sh",
        "package:win": "npm run build && electron-builder --win",
        "package:linux": "npm run build && electron-builder --linux",
        "package:all": "npm run build && electron-builder --mac --win --linux"
    },
    "keywords": [
        "electron",
        "github",
        "actions"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/auto-launch": "^5.0.5",
        "@types/node": "^20.10.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.8",
        "vue": "^3.4.0",
        "wait-on": "^7.2.0"
    },
    "dependencies": {
        "@octokit/rest": "^20.0.0",
        "auto-launch": "^5.0.5",
        "electron-store": "^8.1.0",
        "electron-updater": "^6.8.9"
    }
}
