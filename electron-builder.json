{
    "appId": "com.progressy.app",
    "productName": "Progressy",
    "directories": {
        "output": "release"
    },
    "publish": [
        {
            "provider": "github",
            "owner": "sietzekeuning",
            "repo": "progressy"
        }
    ],
    "files": [
        "dist/**/*",
        "src/assets/**/*",
        "package.json",
        "node_modules/@octokit/**/*",
        "node_modules/auto-launch/**/*",
        "node_modules/electron-store/**/*"
    ],
    "win": {
        "target": [
            "nsis",
            "portable"
        ]
    },
    "mac": {
        "target": [
            "dmg",
            "zip"
        ],
        "category": "public.app-category.developer-tools",
        "icon": "src/assets/icons.icns",
        "hardenedRuntime": true,
        "gatekeeperAssess": false,
        "notarize": true
    },
    "linux": {
        "target": [
            "AppImage",
            "deb"
        ],
        "category": "Development"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
    },
    "dmg": {
        "contents": [
            {
                "x": 110,
                "y": 150
            },
            {
                "x": 240,
                "y": 150,
                "type": "link",
                "path": "/Applications"
            }
        ]
    }
}
